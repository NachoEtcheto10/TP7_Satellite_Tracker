{
  "expo": {
    "name": "Orbita",
    "slug": "orbita-satellite-tracker",
    "scheme": "orbita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/orbita-icon-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ar.edu.uader.orbita",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EF",
        "foregroundImage": "./assets/orbita-adaptive-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbita usa tu ubicación para calcular azimut, elevación y pases visibles."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D28D9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "add0007a-1a6d-43f6-9b24-8801e5581d3e"
      }
    }
  }
}
